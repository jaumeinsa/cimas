# ─────────────────────────────────────────────
# Cimas — variables de entorno
# Copia este archivo a `.env` y rellena los valores.
# ─────────────────────────────────────────────

# URL pública de la app (para metadatos OpenGraph)
NEXT_PUBLIC_APP_URL="https://cimas.example.com"

# Verificación con IA (opcional)
# Clave de la API de Anthropic para el botón «Verificar con IA».
# Sin ella, la app funciona igual pero sin verificación con IA.
ANTHROPIC_API_KEY=""
